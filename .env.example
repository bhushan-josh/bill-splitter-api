# Copy this file to `.env` and adjust for your local environment.
# `.env` is git-ignored; `.env.example` is committed as documentation.

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=billsplitter_development
TEST_DATABASE_NAME=billsplitter_test
RAILS_MAX_THREADS=5

# --- Redis / Sidekiq -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
SIDEKIQ_CONCURRENCY=5

# HTTP Basic credentials for the Sidekiq web dashboard (/sidekiq). When both are
# set the dashboard requires them; when unset it is open in development but
# locked down in production.
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins. Use "*" to allow all (dev only).
CORS_ORIGINS=*

# --- Auth ------------------------------------------------------------------
# Secret used to sign/verify JWTs. Generate with `rails secret`.
# Falls back to Rails' secret_key_base when blank.
JWT_SECRET_KEY=
