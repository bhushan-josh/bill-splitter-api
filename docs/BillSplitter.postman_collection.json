            "description": "Remove a friend. `friendId` is the friend's user id. Cascades their friend expenses/settlements/messages."
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create expense (group, equal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) { pm.collectionVariables.set('expenseId', res.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context_type\": \"group\",\n  \"group_id\": {{groupId}},\n  \"title\": \"Dinner\",\n  \"description\": \"Team dinner\",\n  \"amount\": 60.00,\n  \"currency\": \"USD\",\n  \"paid_by_id\": {{userId}},\n  \"split_type\": \"equal\",\n  \"expense_date\": \"2026-07-31\",\n  \"participants\": [\n    { \"user_id\": {{userId}} },\n    { \"user_id\": {{friendId}} }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses"]
            },
            "description": "Equal split. For `percentage` add `percentage` to each participant (sum 100); for `exact` add `amount` to each (sum to total). For a friend expense use context_type=friend + friend_id."
          }
        },
        {
          "name": "Get expense",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses", "{{expenseId}}"]
            },
            "description": "Fetch an expense (must be a member of its context)."
          }
        },
        {
          "name": "Update expense",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dinner (updated)\",\n  \"amount\": 80.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses", "{{expenseId}}"]
            },
            "description": "Creator only. Sending amount/split_type/participants rebuilds the splits."
          }
        },
        {
          "name": "Delete expense",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses", "{{expenseId}}"]
            },
            "description": "Creator only."
          }
        }
      ]
    },
