{
  "info": {
    "_postman_id": "b1115p11-7e12-4a10-9f00-b111c0ffee01",
    "name": "Bill Splitter API",
    "description": "Complete Bill Splitter API collection (all endpoints).\n\nQuick start:\n1. Set the `baseUrl` collection variable (default http://localhost:3000).\n2. Run **Auth > Signup** (or Login). The test script saves the JWT into the `token` variable, which every other request uses automatically via Bearer auth.\n3. Create a second user (Signup again after clearing token, or set `receiverId`) to exercise friends/expenses/settlements.\n\nRequests that create a resource save its id into a collection variable (e.g. `groupId`, `expenseId`) so later requests can reuse it. Edit the JSON bodies and `*_id` variables to match your data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "receiverId", "value": "" },
    { "key": "friendRequestId", "value": "" },
    { "key": "friendId", "value": "" },
    { "key": "groupId", "value": "" },
    { "key": "newOwnerId", "value": "" },
    { "key": "expenseId", "value": "" },
    { "key": "settlementId", "value": "" },
    { "key": "fromUserId", "value": "" },
    { "key": "toUserId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Public liveness/readiness check (DB + Redis)."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('userId', res.data.user.id);",
                  "  console.log('Saved token for user', res.data.user.username);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"username\": \"user{{$timestamp}}\",\n  \"phone\": \"+1{{$timestamp}}\",\n  \"password\": \"secret1\",\n  \"password_confirmation\": \"secret1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "signup"]
            },
            "description": "Create an account and receive a JWT. Username/phone use dynamic values so it is re-runnable."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('userId', res.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"ada\",\n  \"password\": \"secret1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "login"]
            },
            "description": "Exchange username-or-phone + password for a JWT."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "me"]
            },
            "description": "Current authenticated user's profile."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/search?q=user&page=1&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "search"],
              "query": [
                { "key": "q", "value": "user" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "25" }
              ]
            },
            "description": "Search users by username or phone (excludes yourself)."
          }
        }
      ]
    },
    {
      "name": "Friend Requests",
      "item": [
        {
          "name": "List friend requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/friend_requests?direction=all&status=pending&page=1&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "friend_requests"],
              "query": [
                { "key": "direction", "value": "all", "description": "incoming | outgoing | all (default all)" },
                { "key": "status", "value": "pending", "description": "pending | accepted | rejected | cancelled | all (default pending)" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "25" }
              ]
            },
            "description": "List the current user's friend requests (both directions). Each item is tagged with `direction` (incoming/outgoing)."
          }
        },
        {
          "name": "Send friend request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) { pm.collectionVariables.set('friendRequestId', res.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_id\": {{receiverId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/friend_requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "friend_requests"]
            },
            "description": "Send a request. Set `receiverId` to another user's id."
          }
        },
        {
          "name": "Accept friend request",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/friend_requests/{{friendRequestId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "friend_requests", "{{friendRequestId}}", "accept"]
            },
            "description": "Receiver accepts (creates the mutual friendship)."
          }
        },
        {
          "name": "Reject friend request",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/friend_requests/{{friendRequestId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "friend_requests", "{{friendRequestId}}", "reject"]
            },
            "description": "Receiver rejects a pending request."
          }
        },
        {
          "name": "Cancel friend request",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/friend_requests/{{friendRequestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "friend_requests", "{{friendRequestId}}"]
            },
            "description": "Sender cancels their own pending request."
          }
        }
      ]
    },
    {
      "name": "Friends",
      "item": [
        {
          "name": "List friends",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/friends?page=1&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "friends"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "25" }
              ]
            },
            "description": "Current user's friends, newest first."
          }
        },
        {
          "name": "Unfriend",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/friends/{{friendId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "friends", "{{friendId}}"]
